// RiboPilot local Docker config: run each pipeline process inside the RiboPilot
// image (built from docker/Dockerfile, referenced by process.container). Use this
// instead of config.conda when you want the tools to come from the container
// rather than a local conda env.
//
// The shell / R-script processes open the project SQLite database directly by
// path (RiboPilot does not use nf-sqldb), so the project directory is
// bind-mounted into the container via docker.runOptions. Nextflow already
// mounts each task's work directory. new_project() mounts everything else the
// run reads -- the raw reads, any supplied assemblies, and the folders holding
// local seed/label reference databases -- into the <<EXTRA_MOUNTS>> slot; add
// more -v mounts here if you need them.

// -u and fixOwnership keep container output owned by you. Without them SQLite
// creates root-owned .sqlite-wal / .sqlite-shm files next to the project
// database, which the Shiny app then cannot open and you cannot delete.
docker {
    enabled = true
    fixOwnership = true
    runOptions = "-u \$(id -u):\$(id -g) -v ${params.projectDir}:${params.projectDir}<<EXTRA_MOUNTS>>"
}

process {
    executor = 'local'
    container = '<<CONTAINER_ID>>'
    resourceLimits = [cpus: <<HOST_CPUS>>, memory: <<HOST_MEMORY>>.GB]   // this machine; bigger requests are capped, not fatal
}

params {
    publishDir = 'out'
    rawDir = '<<RAW_DIR>>'
    asmbDir = '<<ASMB_DIR>>'                     // Directory containing user-supplied assemblies
    minDepth = <<MIN_DEPTH>>
    ncbi_api_key = '<<NCBI_API_KEY>>'       // Optional NCBI API key for BLAST + GenBank fetch
}
