// RiboPilot config for the Smithsonian NMNH Hydra cluster (SGE + Singularity).
// Use directly with new_project(executor = "NMNH_Hydra"), which fills in the
// container image, raw-read directory, minimum depth, and NCBI API key.
//
// RiboPilot does not use nf-sqldb: each process opens the project SQLite DB
// directly by path and pulls its own CPU count from the DB, so the container
// bind-mounts the project + raw-read directories (and Hydra's /scratch02).

// Throttle job submission to be a good cluster citizen (adjust as needed)
executor {
    queueSize = 50
    pollInterval = '30 sec'
    submitRateLimit = '10/1min'
}

singularity {
    enabled = true
    autoMounts = true
    pullTimeout = '60 min'   // large image on Hydra's shared filesystem can exceed the 20 min default
    runOptions = "-B ${params.projectDir} -B ${params.rawDir} -B /scratch02/<<EXTRA_MOUNTS>>"
}

// Hydra has no h_rss or mem_free resources, and Nextflow adds
// "-l h_rss=...,mem_free=..." to every job that carries a memory directive, so
// qsub rejects it. Memory is left unset here and requested through Hydra's own
// mres/h_data/h_vmem instead. The withName blocks below also clear the memory
// directives the pipeline itself declares (a selector outranks the process).
process {
    executor = 'sge'
    container = '<<CONTAINER_ID>>'
    penv = 'mthread'
    memory = null
    // Request himem when a job needs more than 8 GB RAM per CPU.
    clusterOptions = {
        def mem = 16 * task.attempt
        def perCpu = mem / (task.cpus ?: 1)
        "-l mres=${mem}G,h_data=${perCpu}G,h_vmem=${perCpu}G${perCpu > 8 ? ',himem' : ''} -S /bin/bash"
    }

    // memory per sample comes from the project database
    withName: 'preprocess|assemble|fallback_assemble|annotate_tools' {
        memory = null
        clusterOptions = {
            def m = (mem as int) * task.attempt
            def perCpu = m / (task.cpus ?: 1)
            "-l mres=${m}G,h_data=${perCpu}G,h_vmem=${perCpu}G${perCpu > 8 ? ',himem' : ''} -S /bin/bash"
        }
    }

    withName: 'coverage' {
        memory = null
        clusterOptions = {
            def m = 8 * task.attempt
            def perCpu = m / (task.cpus ?: 1)
            "-l mres=${m}G,h_data=${perCpu}G,h_vmem=${perCpu}G${perCpu > 8 ? ',himem' : ''} -S /bin/bash"
        }
    }
}

// Pipeline parameters
params {
    publishDir = 'out'                          // Directory to publish pipeline outputs
    rawDir = '<<RAW_DIR>>'                       // Directory containing raw read data
    minDepth = <<MIN_DEPTH>>                     // Skip samples with fewer than this many reads
    ncbi_api_key = '<<NCBI_API_KEY>>'            // Optional NCBI API key for BLAST + GenBank fetch
}
