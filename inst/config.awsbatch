// RiboPilot AWS Batch config. After new_project() creates the .config, fill in
// the AWS-specific placeholders below (queue, region, CLI path) by hand.
//
// IMPORTANT: RiboPilot's processes open the project SQLite database directly by
// path, so AWS Batch requires a shared filesystem (EFS or FSx) mounted at the
// same path on every compute node and holding the project directory. Pure S3
// working directories will not work, because the database cannot be a plain S3
// object. Mount the project filesystem into the container via docker.runOptions
// (add another -v for the raw-read location if it differs).

plugins {
    id 'nf-amazon'
}

// -u and fixOwnership keep container output owned by you. Without them SQLite
// creates root-owned .sqlite-wal / .sqlite-shm files next to the project
// database on the shared filesystem, which the Shiny app then cannot open.
docker {
    enabled = true
    fixOwnership = true
    runOptions = "-u \$(id -u):\$(id -g) -v ${params.projectDir}:${params.projectDir}<<EXTRA_MOUNTS>>"
}

process {
    executor = 'awsbatch'
    container = '<<CONTAINER_ID>>'
    queue = '<<BATCH_QUEUE>>'
}

// AWS Batch parameters (see https://www.nextflow.io/docs/latest/aws.html#aws-batch)
aws {
    region = '<<AWS_REGION>>'
    batch {
        cliPath = '<<AWS_CLI_PATH>>'   // Path to the AWS CLI on your custom AMI
        maxParallelTransfers = 8
    }
    client {
        maxConnections = 16
    }
}

// Pipeline parameters
params {
    publishDir = 'out'                          // Directory to publish pipeline outputs
    rawDir = '<<RAW_DIR>>'                       // Directory containing raw read data
    asmbDir = '<<ASMB_DIR>>'                     // Directory containing user-supplied assemblies
    minDepth = <<MIN_DEPTH>>                     // Skip samples with fewer than this many reads
    ncbi_api_key = '<<NCBI_API_KEY>>'            // Optional NCBI API key for BLAST + GenBank fetch
}
