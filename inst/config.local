// RiboPilot local config: run every process on this machine inside the RiboPilot
// Docker image (same as executor "docker"). For a local conda env instead of a
// container, use executor "conda".
//
// The processes open the project SQLite DB directly by path, so the project and
// raw-read directories are bind-mounted into the container via docker.runOptions.
// Nextflow already mounts each task's work directory. new_project() also mounts
// the directories holding any local seed/label reference databases (the
// <<EXTRA_MOUNTS>> slot); add more -v mounts here if you need them.

docker {
    enabled = true
    runOptions = "-v ${params.projectDir}:${params.projectDir} -v ${params.rawDir}:${params.rawDir}<<EXTRA_MOUNTS>>"
}

process {
    executor = 'local'
    container = '<<CONTAINER_ID>>'
}

params {
    publishDir = 'out'                          // Directory to publish pipeline outputs
    rawDir = '<<RAW_DIR>>'                       // Directory containing raw read data
    minDepth = <<MIN_DEPTH>>                     // Skip samples with fewer than this many reads
    ncbi_api_key = '<<NCBI_API_KEY>>'            // Optional NCBI API key for BLAST + GenBank fetch
}
