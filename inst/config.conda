// RiboPilot local dev config: run processes on the local executor using tools
// from the active `ribopilot` conda env (launch Nextflow with that env on PATH).
// No container/plugin, so it works without nf-sqldb; the R driver handles the
// project database. HPC/container configs come later.

process {
    executor = 'local'
    resourceLimits = [cpus: <<HOST_CPUS>>, memory: <<HOST_MEMORY>>.GB]   // this machine; bigger requests are capped, not fatal
}

params {
    publishDir = 'out'
    rawDir = '<<RAW_DIR>>'
    asmbDir = '<<ASMB_DIR>>'                     // Directory containing user-supplied assemblies
    minDepth = <<MIN_DEPTH>>
    ncbi_api_key = '<<NCBI_API_KEY>>'       // Optional NCBI API key for BLAST + GenBank fetch
}
