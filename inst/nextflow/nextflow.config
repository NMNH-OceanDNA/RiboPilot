// Pipeline-wide defaults, loaded automatically from the script's base directory.
// Nextflow applies this first, so anything in a project's own .config (passed
// with -c) still wins.

// Nextflow's default is ['/bin/bash', '-ue']. Without pipefail, a failing
// command on the left of a pipe is invisible: `bowtie2 | samtools sort` reports
// samtools' status, and samtools exits 0 on an empty stream, so a dead aligner
// produces a valid empty BAM and a scaffold with zero coverage.
process.shell = ['/bin/bash', '-ueo', 'pipefail']

process {
    // Both of these talk to NCBI. Unthrottled, one run submits as many
    // concurrent remote requests as it has slots, which gets the host
    // rate-limited or blocked; the retry then backs off into the same window.
    withName: 'blast_genbank|blast_ref_fetch' {
        maxForks = 3
    }
}
