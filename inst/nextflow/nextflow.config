// Pipeline-wide defaults, loaded automatically from the script's base directory.
// Nextflow applies this first, then merges a project's own .config (passed
// with -c) on top, so most settings here are overridden by it. The `env`
// block below is an exception: it is evaluated while this file is parsed,
// before the -c file is read, so params set only in a project .config are
// NOT visible to it.

// Nextflow's default is ['/bin/bash', '-ue']. Without pipefail, a failing
// command on the left of a pipe is invisible: `bowtie2 | samtools sort` reports
// samtools' status, and samtools exits 0 on an empty stream, so a dead aligner
// produces a valid empty BAM and a scaffold with zero coverage.
process.shell = ['/bin/bash', '-ueo', 'pipefail']

// Optional params, declared here rather than in main.nf: Nextflow 25.x does not
// treat a script-level `params.x = ''` as a definition, and nf_command() passes
// --ref_dir / --blastdb only when they are set, so a project configured with
// neither warned "Access to undefined parameter" once per task.
params {
    ref_dir = ''
    blastdb = ''
    ribopilot_src = ''
}

// OpenBLAS sizes its thread pool from the core count of the whole NODE, not from
// the task's allocation, and reserves a buffer per thread up front. On a 64-core
// cluster node that is tens of GB of address space for R and for numpy (pybarrnap),
// against a few hundred MB actually used, which trips any per-process address-space
// limit the scheduler sets. Nothing here does linear algebra worth threading.
// OMP_NUM_THREADS is deliberately NOT set: SPAdes uses OpenMP for real work.
// env as a map, not a block, so the opt-out key can be left out entirely: an
// empty or null value warns once per task, and the config parser rejects the
// `if` that would otherwise skip it.
env = [
    OPENBLAS_NUM_THREADS: 1,
    // A -c project config's params.ncbi_api_key is NOT visible here (see header
    // comment). The key must arrive as a CLI --ncbi_api_key (R/nf_command.R:47,
    // R/reference_nf.R:159 do this) or as a shell NCBI_API_KEY env var.
    NCBI_API_KEY: (params.containsKey('ncbi_api_key') ? params.ncbi_api_key : null) ?: System.getenv('NCBI_API_KEY')
].findAll { it.value } + (System.getenv('RIBOPILOT_NO_LOCAL_BLAST')
    // Docker tasks are launched with only NXF_TASK_WORKDIR forwarded, so a
    // shell-set opt-out never reaches the container and the baked-in database
    // is used anyway. Naming it here is what carries it across.
    ? [RIBOPILOT_NO_LOCAL_BLAST: System.getenv('RIBOPILOT_NO_LOCAL_BLAST')]
    : [:])

process {
    // Both of these talk to NCBI. Unthrottled, one run submits as many
    // concurrent remote requests as it has slots, which gets the host
    // rate-limited or blocked; the retry then backs off into the same window.
    withName: 'blast_genbank|blast_ref_fetch' {
        maxForks = 3
    }

    // The memory-hungry processes. A kill for running out of memory (137/140/143
    // from the scheduler, 104/134/139/247 from the tool itself) is retried, and
    // the per-process memory closures scale with task.attempt, so the sample gets
    // a bigger allocation each time. Anything else, or a retry budget spent, ends
    // as 'ignore': one bad sample still does not stop the run.
    withName: 'assemble|fallback_assemble|preprocess|annotate_tools|find_rrna_scan' {
        errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] && task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
    }
}
