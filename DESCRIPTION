    dplyr,
    gggenes,
    ggplot2,
    glue,
    golem,
    jsonlite,
    purrr,
    reactable,
    readr,
    RSQLite,
    shiny,
    shinyWidgets,
    stringr,
    tools,
    utils
Suggests:
    knitr,
    testthat (>= 3.0.0)
Encoding: UTF-8
